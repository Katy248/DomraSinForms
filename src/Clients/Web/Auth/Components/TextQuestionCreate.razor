@using DomraSinForms.Application.Questions.Commands.CreateTextQuestion
@using DomraSinForms.Domain.Models.Questions
@using DomraSinForms.Clients.Web.Blazor.Helpers
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<LocalizationData> Localizer
<h3>TextQuestionEdit</h3>
<div class="modal" id="@(ModalId)">
    <div class="modal-dialog modal-dialog-centered">
        
        <div class="modal-content p-1">
            @if (Model is null)
            {
                <h3 class="text-danger">Something went wrong</h3>
            }
            else
            {
            <div class="modal-body justify-content-center">

                <div class="h2 mb-5 text-center">@Localizer["Create text question"]</div>
                <EditForm Model="Command">
                    <div class="form-group mb-2">
                    <InputText @bind-Value="Command.QuestionText" placeholder="Question text"/>
                    </div>
                </EditForm>
                <form asp-controller="Questions" asp-action="UpdateTextQuestion" method="post">

                    <input asp-for="Command.Id" value="@Model.Id" hidden/>

                        <input class="form-control form-control-lg" type="text"  asp-for="Command.QuestionText"/>
                        <span asp-validation-for="Command.QuestionText" class="text-danger"></span>

                    <div class="form-check mb-2">
                        <label class="form-check-label">["Required"]</label>
                        <input class="form-check-input" type="checkbox" asp-for="Command.IsRequired"/>
                    </div>

                    <div class="form-group mb-2">
                        <label class="form-label">["Index"]</label>
                        <input class="form-control" type="number" asp-for="Command.Index"/>
                    </div>

                    <div class="form-group mb-2">
                        <label class="form-label">["Question type"]</label>
                        <select class="form-select" asp-for="Command.Type" asp-items="@(QuestionsHelper.TextQuestionTypesSelect())"></select>
                    </div>

                    <div class="form-group mb-2">
                        <input class="form-control btn btn-primary" type="submit" value="Save"/>
                    </div>

                </form>

            </div>

            }
        </div>
    </div>
</div>

@code {
    public const string DefaultModalId = "create-text-question-modal";
    [Parameter] public string ModalId { get; set; } = DefaultModalId;
    [Parameter] public string FormId { get; set; }
    TextQuestion Model { get; set; } = new TextQuestion() { };

    CreateTextQuestionCommand Command => new();

}